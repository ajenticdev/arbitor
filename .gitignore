# Root .gitignore for Arbitor

# -----------------------------------------------------------------------------
# Operating System Noise
# -----------------------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editor And IDE Files
# -----------------------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# RustRover / JetBrains
# JetBrains-specific ignores are usually better handled through a global
# gitignore. Uncomment only if the repo chooses to ignore all JetBrains project
# files locally.
#.idea/

# -----------------------------------------------------------------------------
# Environment And Local Configuration
# -----------------------------------------------------------------------------

.env
.env.*
*.local

# Do not ignore checked-in example environment files.
!.env.example
!.env.sample

# -----------------------------------------------------------------------------
# Logs And Runtime Output
# -----------------------------------------------------------------------------

*.log
logs/
log/
*.out
*.err

# -----------------------------------------------------------------------------
# Rust / Cargo
# -----------------------------------------------------------------------------

# Generated by Cargo.
# Contains compiled files and executables.
target/
debug/

# Backup files generated by rustfmt.
**/*.rs.bk

# MSVC Windows builds of rustc generate these debugging files.
*.pdb

# Generated by cargo-mutants.
# Contains mutation testing data.
**/mutants.out*/

# Keep Cargo.lock tracked for application reproducibility.
!Cargo.lock

# -----------------------------------------------------------------------------
# Node / TypeScript / Tauri UI
# -----------------------------------------------------------------------------

node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo

# Keep package lockfiles tracked for reproducible builds.
!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!bun.lockb

# -----------------------------------------------------------------------------
# Tauri Build Output
# -----------------------------------------------------------------------------

src-tauri/target/
ui/src-tauri/target/

# -----------------------------------------------------------------------------
# Test And Coverage Artifacts
# -----------------------------------------------------------------------------

coverage/
*.profraw
*.profdata
junit.xml
test-results/
playwright-report/

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------

tmp/
temp/
.cache/

# -----------------------------------------------------------------------------
# Security-Sensitive Local Files
# -----------------------------------------------------------------------------

*.key
*.pem
*.p12
*.pfx
*.crt
*.csr

# Do not ignore documentation, schemas, tests, scripts, source files, or lockfiles.
